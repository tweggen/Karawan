<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" />
    <!--
      The openal-soft binaries come from Karawan.Natives, built by our own pinned CI
      (WP-1.2) rather than from Silk.NET.OpenAL.Soft.Native (WP-1.5).

      WP-3.4 removed the last Silk dependency here: Silk.NET.OpenAL and its Enumeration and
      Soft extension packages are gone, replaced by Native/OpenALNative.cs. The NATIVE
      library is unchanged - only the managed binding.

      The name-candidate fallback WP-1.5 relied on Silk for now lives in
      OpenALNative._candidates: this repo ships OpenAL32.dll on Windows where Silk's package
      shipped soft_oal.dll, and both names are tried. That fallback is load-bearing, not
      defensive - a single-name DllImport reintroduces the exact breakage WP-1.5 diagnosed,
      and does so at first playback rather than at startup.
    -->
    <PackageReference Include="Karawan.Natives" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boom\Boom.csproj" />
  </ItemGroup>

</Project>
