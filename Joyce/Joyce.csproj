<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="clipper.NetStandard2" />
    <PackageReference Include="ImGui.NET" />
    <PackageReference Include="LibTessDotNet" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="NetOctree" />
    <PackageReference Include="NLua" />
    <PackageReference Include="OneOf" />
    <!--
      Silk.NET.Assimp is deliberately absent (WP-4.4). The fbx importer moved to
      JoyceFbx, which only the build tools reference, so Assimp is no longer part
      of any shipped binary. Adding it back here would put it into every runtime
      target again, since they all reference Joyce.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Collections" />
  </ItemGroup>

  <ItemGroup>
    <!-- Siblings of this repository. $(SiblingRoot) is resolved in Directory.Build.props. -->
    <ProjectReference Include="$(SiblingRoot)/BepuPhysics2/BepuPhysics/BepuPhysics.csproj" />
    <ProjectReference Include="$(SiblingRoot)/BepuPhysics2/BepuUtilities/BepuUtilities.csproj" />
    <ProjectReference Include="$(SiblingRoot)/DefaultEcs/source/DefaultEcs/DefaultEcs.csproj" />
    <ProjectReference Include="$(SiblingRoot)/glTF-CSharp-Loader/glTFLoader/glTFLoader.csproj" />
    <ProjectReference Include="$(SiblingRoot)/ObjLoader/source/CjClutter.ObjLoader.Loader/CjClutter.ObjLoader.Loader.csproj" />
    <ProjectReference Include="..\ExpectEngine\ExpectEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the unit test suite reach internal helpers (e.g. SpatialModel street entry snapping). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JoyceCode.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    No Mono.Android reference here on purpose. Joyce targets plain net9.0 and none of the
    shared JoyceCode sources touch the Android API; the Android bindings reach the app
    through Wuka, whose net9.0-android target framework supplies them automatically.

    A hard-coded <Reference Include="Mono.Android"> used to sit here pointing six levels
    up into "Program Files\dotnet\packs\Microsoft.Android.Ref.34\34.0.79\ref\net8.0" -
    Windows-only, tied to the machine's directory depth, and pinned to an SDK and target
    framework the repository has since moved off. It resolved on nobody's machine and
    only produced an MSB3245 on every single build.
  -->

  <Import Project="..\JoyceCode\JoyceCode.projitems" Label="Shared" />

</Project>
