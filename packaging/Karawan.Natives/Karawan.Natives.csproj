<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packaging-only project (WP-1.4). It compiles nothing: it exists so that `dotnet pack`
    can turn the CI matrix's native artifacts into a versioned NuGet package.

    Content is taken from a staging directory produced by recipes/pack-natives.sh, not
    from the repository, so this project never carries binaries in git.

    Deliberately NOT part of Karawan.sln - it has no source, and adding it would put a
    packaging step into every developer's build.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>true</IsPackable>

    <PackageId>Karawan.Natives</PackageId>
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <Authors>nassau records</Authors>
    <Description>
      Native libraries (openal-soft, SDL3) built by Karawan's own pinned CI matrix for
      linux-x64, win-x64, osx-arm64, osx-x64 and Android arm64-v8a/armeabi-v7a.
      Android binaries are 16 KB page aligned. See build-manifest.json in the package for
      the exact upstream tags, commits and toolchains each binary was produced from.
    </Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tweggen/Karawan</RepositoryUrl>
    <PackageTags>native;openal;sdl3;android</PackageTags>

    <!-- Staging directory produced by recipes/pack-natives.sh. -->
    <NativesStage Condition="'$(NativesStage)' == ''">$(MSBuildThisFileDirectory)../../artifacts/stage</NativesStage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A package with no lib/ assembly is reported as incompatible with every framework.
      The conventional _._ placeholder says "there is deliberately nothing to reference
      here"; the payload is all runtimes/ and the Android .aar.
    -->
    <None Include="$(MSBuildThisFileDirectory)_._" Pack="true" PackagePath="lib/netstandard2.0/_._" />

    <!-- Desktop natives, resolved per-RID by the .NET host at run time. -->
    <None Include="$(NativesStage)/runtimes/**/*"
          Pack="true"
          PackagePath="runtimes" />

    <!--
      Android. .NET Android extracts jni/<abi>/ from an .aar found under lib/<tfm>/.
      android34.0 rather than the app's android36.0: NuGet picks the highest compatible
      lower TFM, so this stays consumable if the app's target moves.
    -->
    <None Include="$(NativesStage)/aar-out/*.aar"
          Pack="true"
          PackagePath="lib/net9.0-android34.0" />

    <!--
      KI-5. THIS PLACEHOLDER IS LOAD-BEARING - without it the .aar above is never
      delivered to anyone.

      NuGet decides which frameworks a package supports by scanning lib/<tfm>/ for files
      it recognises: assemblies (.dll/.exe/.winmd) and the _._ marker. An .aar is none of
      those, so a folder containing ONLY an .aar registers no framework at all.
      net9.0-android34.0 was therefore absent from the package's supported set, NuGet fell
      back to lib/netstandard2.0/_._ via AssetTargetFallback, and every Android consumer
      silently got nothing:

        warning NU1701: Package 'Karawan.Natives 0.1.0' was restored using
          '.NETFramework,Version=v4.6.1, ...' instead of 'net9.0-android35.0'
        project.assets.json:  compile -> lib/netstandard2.0/_._

      Silk.NET.Windowing.Sdl does not hit this because it ships a real assembly beside its
      .aar. We have no assembly to ship, so _._ is the correct equivalent: it declares the
      framework supported while adding nothing to reference.

      Found by WP-2.1, which could not get libSDL3.so into an APK at all. WP-1.5 had
      masked it by excluding the package's Android assets for unrelated reasons.
    -->
    <None Include="$(MSBuildThisFileDirectory)_._"
          Pack="true"
          PackagePath="lib/net9.0-android34.0/_._" />

    <!--
      KI-6. Android RIDs inherit from linux in the RID graph, so with no android-* entry
      here NuGet's RID fallback resolves runtimes/linux-x64/native for an Android build
      and packages glibc x86-64 .so files into the APK - not loadable on Bionic, and not
      16 KB aligned. WP-2.1 caught it only because that project promotes XA0141 to an
      error:

        error XA0141: ... 'libSDL3.so' ... contains 'runtimes/linux-x64/native/libSDL3.so'

      Empty android RID folders give the fallback an exact match, so it stops here instead
      of walking up to linux-x64. The real Android payload travels in the .aar above.
      This is the same defect class as ImGui.NET's linux-x64 libcimgui.so (WP-0.3 4.2) and
      is what plan AC-1.3 forbids.
    -->
    <None Include="$(MSBuildThisFileDirectory)_._"
          Pack="true"
          PackagePath="runtimes/android-arm64/native/_._" />
    <None Include="$(MSBuildThisFileDirectory)_._"
          Pack="true"
          PackagePath="runtimes/android-arm/native/_._" />

    <!--
      The targets file that actually declares the .aar as an AndroidLibrary. Without it,
      the .aar ships inside the package and reaches nobody - see the file for the
      measurement that proves lib/<tfm>/*.aar alone is not enough.

      Both build/ and buildTransitive/: build/ applies to direct references,
      buildTransitive/ carries it through project references, which is how Wuka would pick
      it up via Boom.OpenAL.
    -->
    <None Include="$(MSBuildThisFileDirectory)build/Karawan.Natives.targets"
          Pack="true"
          PackagePath="build/Karawan.Natives.targets" />
    <None Include="$(MSBuildThisFileDirectory)build/Karawan.Natives.targets"
          Pack="true"
          PackagePath="buildTransitive/Karawan.Natives.targets" />

    <!-- Provenance travels inside the package, not only in CI logs. -->
    <None Include="$(NativesStage)/manifest/build-manifest.json"
          Pack="true"
          PackagePath="build-manifest.json" />
  </ItemGroup>

</Project>
