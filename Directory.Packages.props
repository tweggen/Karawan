<Project>
  <!--
    Central Package Management (WP-0.1, docs/roadmap/proposed/IMPLEMENTATION-PLAN-PLATFORM-BACKEND.md).

    Every NuGet version in the repository lives here. Individual csprojs carry
    <PackageReference Include="..." /> with NO Version attribute.

    Rules:
      - These versions are a VERBATIM capture of what resolved before the migration.
        WP-0.1 is a no-op on resolution by construction (AC-0.1.3). Do not "tidy" a
        version here without checking what depends on it.
      - Silk.NET.Assimp is deliberately pinned to 2.22.0 and MUST NOT be bumped.
        Bumping it is what corrupted model loading; see non-negotiable N5/N8 in the
        implementation plan and docs/ARCHITECTURE/PLATFORM_BACKEND.md.
      - Two packages are referenced at two different versions by different projects.
        CPM allows only one central version each, so the odd one out uses
        VersionOverride at its call site rather than being unified - unifying would
        change the resolved set, which AC-0.1.3 forbids. Both are flagged below.
      - Aihao.old/ is dead code and is excluded via its own Directory.Packages.props,
        which sets ManagePackageVersionsCentrally=false.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Avalonia / Aihao editor">
    <PackageVersion Include="Avalonia" Version="11.3.8" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.8" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.8" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.8" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Dock.Avalonia" Version="11.3.8" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageVersion Include="Dock.Model" Version="11.3.8" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="11.3.8" />
  </ItemGroup>
  <ItemGroup Label="Silk.NET - REMOVED except the build-time fbx importer">
    <!--
      WP-5.4 pruned this group down to Assimp. Silk.NET.Core, .OpenGL,
      .OpenGL.Extensions.EXT, .OpenGL.Extensions.ImGui and .Windowing all had zero
      PackageReferences left: windowing went in Phase 3, the ImGui extension in
      WP-5.3, the GL binding in WP-5.2, and Core was unused after WP-4.4.

      A PackageVersion with no PackageReference is inert, so these cost nothing at
      build time - but they misrepresent the dependency graph to anyone reading
      this file, which is the one place you would look to answer "what do we still
      take from Silk?". The answer is now visible: the fbx importer, at build time
      only.

      N5/N8: Assimp is pinned deliberately. Do not bump - that is the mechanism
      that corrupted model loading. It reaches only JoyceFbx, which no shipping
      project references (WP-4.4).
    -->
    <PackageVersion Include="Silk.NET.Assimp" Version="2.22.0" />
    <PackageVersion Include="Ultz.Native.Assimp" Version="5.4.1" />
  </ItemGroup>
  <ItemGroup Label="Natives built by our own CI">
    <!--
      openal-soft and SDL3, built by .github/workflows/natives.yml from pinned upstream
      tags and published by an explicit manual dispatch. Replaces
      Silk.NET.OpenAL.Soft.Native as the native source (WP-1.5).

      Comes from nuget.org rather than GitHub Packages: GitHub Packages NuGet requires
      authentication even for public packages, which would have made a PAT a prerequisite
      for building this repository at all. See recipes/BUILD_NOTES.md.
    -->
    <PackageVersion Include="Karawan.Natives" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup Label="Engine">
    <PackageVersion Include="clipper.NetStandard2" Version="6.4.2" />
    <PackageVersion Include="ImGui.NET" Version="1.91.6.1" />
    <PackageVersion Include="LibTessDotNet" Version="1.1.15" />
    <PackageVersion Include="LiteDB" Version="5.0.15" />
    <PackageVersion Include="MessagePack" Version="3.1.4" />
    <PackageVersion Include="NetOctree" Version="2.1.0" />
    <PackageVersion Include="NLua" Version="1.7.6" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
  </ItemGroup>
  <ItemGroup Label="Imaging">
    <!--
      CONFLICT: Karawan and examples/Launcher use 3.1.10; Splash.Silk uses 3.0.1.
      Splash.Silk carries VersionOverride="3.0.1". Unifying would change resolution.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.10" />
    <PackageVersion Include="SkiaSharp" Version="3.119.1" />
    <!--
      CONFLICT: Karawan and examples/Launcher use 2.88.7; Tooling/Cmdline uses 3.119.1
      (Cmdline is on the SkiaSharp 3.x line throughout). Tooling/Cmdline carries
      VersionOverride="3.119.1".
    -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.7" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup Label="Build tooling / BCL">
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.9.5" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.9.5" />
    <PackageVersion Include="System.Collections" Version="4.3.0" />
    <PackageVersion Include="System.Text.Json" Version="9.0.10" />
    <PackageVersion Include="System.Threading.Tasks" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup Label="Android">
    <!--
      WP-6.1 removed Microsoft.Maui.Controls: Wuka no longer uses MAUI at all.
      Xamarin.AndroidX.Core replaces what MAUI used to supply transitively -
      ActivityCompat is used directly by both activities.
    -->
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.15.0.1" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>