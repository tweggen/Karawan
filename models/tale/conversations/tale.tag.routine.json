{
  "start": "entry",
  "nodes": {
    "entry": {
      "flow": [
        {
          "goto": [
            { "if": "props.npc.player_fact.hit_me == 1", "goto": "hostile" },
            { "if": "props.npc.met_player == 'false' && props.npc.group_standing >= 0.05", "goto": "group_warm" },
            { "if": "props.npc.met_player == 'false' && props.npc.group_standing <= -0.15", "goto": "group_cold" },
            { "else": "default" }
          ]
        }
      ]
    },
    "default": {
      "flow": [
        {
          "texts": [
            "Just getting through the day.",
            "Same as always.",
            "It's been a day.",
            "Nothing new to report."
          ]
        }
      ]
    },
    "hostile": {
      "flow": [
        {
          "texts": [
            "You. Stay away from me.",
            "Don't come any closer. I remember what you did."
          ]
        }
      ]
    },
    "group_warm": {
      "flow": [
        {
          "texts": [
            "{func.npcGroupName()} speaks well of you. Good to meet you.",
            "You're the one {func.npcGroupName()} talks about. Welcome."
          ]
        }
      ]
    },
    "group_cold": {
      "flow": [
        {
          "texts": [
            "{func.npcGroupName()} knows about you. Keep your distance.",
            "I've heard what you're like. My people don't forget."
          ]
        }
      ]
    }
  }
}
