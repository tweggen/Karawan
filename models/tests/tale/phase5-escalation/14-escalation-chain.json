{
  "name": "Escalation chain - report, investigation, arrest",
  "description": "crime_report request, then investigate_crime, then prepare_arrest, which needs the evidence_found tag: each link enables the next.",
  "phase": "phase-5",
  "category": "escalation",
  "priority": "high",
  "globalTimeout": 120,
  "steps": [
    {
      "expect": {
        "type": "npc_created"
      },
      "count": 11,
      "timeout": 10,
      "comment": "10 NPCs and the player proxy created"
    },
    {
      "expect": {
        "type": "request_emitted",
        "codeMatches": "^\\d+:crime_report$"
      },
      "timeout": 60,
      "comment": "A crime is reported"
    },
    {
      "expect": {
        "type": "node_arrival",
        "code": "investigate_crime"
      },
      "timeout": 60,
      "comment": "Investigation"
    },
    {
      "expect": {
        "type": "node_arrival",
        "code": "prepare_arrest"
      },
      "timeout": 60,
      "comment": "Arrest prepared (evidence_found tag set)"
    },
    {
      "action": "quit",
      "result": "pass"
    }
  ]
}
