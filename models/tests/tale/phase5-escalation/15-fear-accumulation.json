{
  "name": "Threat and flee response",
  "description": "After a protection demand, threatened NPCs run flee_from_threat.",
  "phase": "phase-5",
  "category": "escalation",
  "priority": "high",
  "globalTimeout": 120,
  "steps": [
    {
      "expect": {
        "type": "npc_created"
      },
      "count": 11,
      "timeout": 10,
      "comment": "10 NPCs and the player proxy created"
    },
    {
      "expect": {
        "type": "escalation_triggered",
        "codeMatches": ":demand_protection:"
      },
      "timeout": 60,
      "comment": "Protection demanded"
    },
    {
      "expect": {
        "type": "node_arrival",
        "code": "flee_from_threat"
      },
      "timeout": 60,
      "comment": "A threatened NPC flees"
    },
    {
      "action": "quit",
      "result": "pass"
    }
  ]
}
