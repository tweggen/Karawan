<?xml version='1.0' encoding='utf-8'?>
<jt>
    <view layer='pausemenu' id='menuLogin'>
        <text 
                x='480' y='120' width='100' height='40' 
                vAlign='center' hAlign='center' 
                fillColor='#448822' color='#000000'
                onClick='joyce:ev("nogame.login.Start")'
        >START</text>
        <vmenu width='250' x='200' y='80'>
            <text height='40' color='#666666' vAlign='center'>Choose system to connect to...</text>
            <option
                    height="20"
                    color='#999999'
                    isDefaultFocus='return (nogame:getConfig().LoginMode == 0)'
                    onClick='joyce:ev("nogame.login.loginGlobally")'
            >
                global machine (online)
            </option>
            <option 
                    height='20' 
                    color='#999999'
                    isDefaultFocus='return (nogame:getConfig().LoginMode == 1)'
                    onClick='joyce:ev("nogame.login.loginLocally")'
            >local machine (offline)</option>
            <text color='#666666' height='40' vAlign='center'>use these credentials to connect to...</text>
            <hbox height="20">
                <text color='#999999' width="120" focusFor="ui.username">
                    eMail
                </text>
                <input
                        id="ui.username"
                        width="120"
                        color='#448822'
                        onInit='widget["text"]=nogame:getConfig().Username'
                        onChange='nogame:getConfig().WebToken = ""; nogame:getConfig().Username = widget["text"]; joyce:ev("nogame.config.save")'/>
            </hbox>
            <hbox height="20">
                <text color='#999999' width="120" focusFor="ui.password">
                    Password
                </text>
                <input id="ui.password"
                       width="120"
                       color='#448822'
                       type="password"
                       onInit='widget["text"]=nogame:getConfig().Password'
                       onChange='nogame:getConfig().WebToken = ""; nogame:getConfig().Password = widget["text"]; joyce:ev("nogame.config.save")'/>
            </hbox>
            <text> </text>
            <hmenu height="20" id='ui.newGlobally'>
                <text color='#999999' width="120" focusFor='ui.newGlobally'>
                    new (globally)
                </text>
                <option color='#999999' width="40">
                    no
                </option>
                <option color='#999999' width="140" onClick='joyce:ev("nogame.login.newGlobally")'>
                    yes, destroy old
                </option>
                <option color='#999999' width="40">
                    nay
                </option>
            </hmenu>
            <!-- text height="20" vAlign="center" id='menuLoginStatusText' color='#448822' width="120"></text --> 
            <option height="40" color='#999999'  vAlign='center' onClick='os.exit()'>
                Exit...
            </option>
        </vmenu>
    </view>
    <view layer='pausemenu' id='menuOptions'>
        <vbox width='250' x='200' y='200'>
            <text color='#666666' height='40'>Options</text>
            <option color="#999999" onClick='jt:replaceAll("pausemenu", "menuInventory")'>Inventory...</option>
            <option color="#999999" onClick='jt:replaceAll("pausemenu", "menuQuestLog")'>Quest Log...</option>
            <option color="#999999" onClick='jt:replaceAll("pausemenu", "menuControls")'>Controls...</option>
            <option color='#999999' onClick='joyce:ev("nogame.modules.menu.toggleMenu")'>Continue</option>
            <option color='#999999' onClick='jt:replaceAll("pausemenu", "menuHelp")'>Help...</option>
            <option color='#999999' onClick='os.exit()'>Exit to desktop...</option>
            <option color='#999999' onClick='joyce:ev("nogame.modules.menu.save")'>Quicksave</option>
        </vbox>
    </view>
    <view layer='pausemenu' id='menuInventory'>
        <vmenu width='250' x='200' y='100'>
            <text color='#666666' height='40'>Inventory</text>
            <for items='{return inv:getItemTextList()}'>
                <hmenu height="20">
                    <option color='#999999' width='200' onClick='joyce:ev("nogame.modules.menuInventory.showDetail", id)' text="{return text}"/>
                    <option color='#999999' width='40' onClick='joyce:ev("nogame.modules.menuInventory.useItem", id)'>Use</option>
                    <option color='#999999' width='40' onClick='joyce:ev("nogame.modules.menuInventory.dropItem", id)'>Drop</option>
                </hmenu>
            </for>
            <option color='#999999' onClick='jt:replaceAll("pausemenu", "menuOptions")'>Back...</option>
        </vmenu>
    </view>
    <view layer='pausemenu' id='menuQuestLog'>
        <vmenu width='250' x='200' y='100'>
            <text color='#666666' height='40'>Quest Log</text>
            <for items='{return questlog:getQuestList()}'>
                <hmenu height="20">
                    <text color='#999999' height='20' text="{return title}"/>
                    <if test='{return active}'>
                        <if test='{return followed}'>
                            <option color='#88ff88' height='20' onClick='questlog:unfollowQuest(); jt:refresh("pausemenu","menuQuestLog")'>Unfollow</option>
                        </if>
                        <if test='{return not followed}'>
                            <option color='#aaaaaa' height='20' onClick='questlog:followQuest(id); jt:refresh("pausemenu","menuQuestLog")'>Follow</option>
                        </if>
                    </if>
                </hmenu>
            </for>
            <option color='#999999' onClick='jt:replaceAll("pausemenu", "menuOptions")'>Back...</option>
        </vmenu>
    </view>
    <!--
        Controls. Rows come from the live binding table, so what is printed here is what
        is actually bound - including the player's own rebindings, and including any
        action a later update adds.

        The key labels are LAYOUT-DEPENDENT and asked of the platform (see
        ControlLabels): an AZERTY player is shown "Z" for the key an English player is
        shown "W", because that is the key they will press. What is stored is neither -
        it is the physical position.

        Analog rows (move, look, brake, accelerate) render without a Rebind option.
        Capture recognises a key or button PRESS, and a stick does not press.
    -->
    <view layer='pausemenu' id='menuControls'>
        <vmenu width='420' x='120' y='60'>
            <text color='#666666' height='40'>Controls</text>
            <if test='{return bindings:isCapturing()}'>
                <text color='#ffcc44' height='20'>Press a key or button... (Escape cancels)</text>
                <option color='#999999' height='20'
                        onClick='bindings:cancelCapture(); jt:refresh("pausemenu","menuControls")'>Cancel</option>
            </if>
            <if test='{return not bindings:isCapturing()}'>
                <for items='{return bindings:getActionList()}'>
                    <hmenu height="20">
                        <text color='#999999' width='170' height='20' text="{return description}"/>
                        <text color='#66aacc' width='170' height='20' text="{return controls}"/>
                        <if test='{return canRebind}'>
                            <option color='#aaaaaa' width='80' height='20'
                                    onClick='bindings:beginCapture(action); jt:refresh("pausemenu","menuControls")'>Rebind</option>
                        </if>
                    </hmenu>
                </for>
                <option color='#999999' height='20'
                        onClick='bindings:resetDefaults(); jt:refresh("pausemenu","menuControls")'>Reset to defaults</option>
                <option color='#999999' height='20'
                        onClick='jt:replaceAll("pausemenu", "menuOptions")'>Back...</option>
            </if>
        </vmenu>
    </view>
    <view layer='pausemenu' id='menuHelp'>
        <vbox width='250' x='200' y='100'>
            <text color='#666666' height='40'>Help</text>
            <!--
                Only the keys that are NOT bindings live here now. Everything a player can
                rebind is on the Controls screen, read from the table it is actually bound
                in - this list used to name WASD, ESC and tab, which a single rebind turned
                into a lie with nothing to catch it.
            -->
            <text color='#999999'>F8 - debug</text>
            <text color='#999999'>F10 - demo ride</text>
            <text color='#999999'>F11 - full screen</text>
            <text color='#999999'>F12 - joyce ui</text>
            <text color='#999999'> </text>
            <option color='#999999' onClick='jt:replaceAll("pausemenu", "menuControls")'>Controls...</option>
            <option color='#999999' onClick='jt:replaceAll("pausemenu", "menuOptions")'>Back...</option>
        </vbox>
    </view>
</jt>
