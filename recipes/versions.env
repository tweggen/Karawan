# Pinned upstream sources for the native libraries Karawan builds itself.
#
# Single source of truth: sourced by recipes/build-*.sh and exported into the CI
# environment by .github/workflows/natives.yml, so a version is changed in exactly
# one place.
#
# Each library is pinned by BOTH tag and commit SHA. The tag is what a human reads;
# the SHA is what actually guarantees reproducibility, because a tag can be moved or
# re-cut upstream. The build scripts check out the tag and then FAIL if HEAD does not
# match the recorded SHA - see recipes/BUILD_NOTES.md.
#
# The Android NDK revision is deliberately NOT here: it is needed by the workflow
# before any step could source this file, so it lives in the workflow's env: block.

# https://github.com/kcat/openal-soft
OPENAL_TAG=1.24.3
OPENAL_COMMIT=dc7d7054a5b4f3bec1dc23a42fd616a0847af948

# https://github.com/libsdl-org/SDL
SDL3_TAG=release-3.4.14
SDL3_COMMIT=147a8ee32dbf9ac02f3794964490687b6bbda1bc
# 0.2.0: the Android payload in 0.1.0 was undeliverable (KI-5) and the package leaked
# linux-x64 natives into Android APKs (KI-6). Both are packaging-only fixes - the binaries
# themselves are unchanged - but consumers cannot get the Android half at all until this
# is published. See packaging/Karawan.Natives/build/Karawan.Natives.targets.
NATIVES_PACKAGE_VERSION=0.2.0
