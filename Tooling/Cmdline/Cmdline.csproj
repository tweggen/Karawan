<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFrameworks>net9.0;netstandard2.0</TargetFrameworks>
        <SelfContained>True</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Bundle native NuGet assets (libSkiaSharp.dll etc.) inside the
             single-file exe so they're extracted to a temp dir at runtime
             and become discoverable by [DllImport]. Without this,
             PublishSingleFile drops native deps from the bundle and
             SkiaSharp fails with DllNotFoundException at first use. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>joycecmd</AssemblyName>
        <TargetName>joycecmd</TargetName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Build.Framework" Version="17.9.5" />
      <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.9.5" />
      <PackageReference Include="SkiaSharp" Version="3.119.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
      <PackageReference Include="System.Text.Json" Version="9.0.10" />
		<!-- PackageReference Include="UkooLabs.FbxSharpie" Version="1.0.99" /-->
    </ItemGroup>

</Project>
