<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
        <SelfContained>True</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Bundle native NuGet assets (libSkiaSharp.dll etc.) inside the
             single-file exe so they're extracted to a temp dir at runtime
             and become discoverable by [DllImport]. Without this,
             PublishSingleFile drops native deps from the bundle and
             SkiaSharp fails with DllNotFoundException at first use. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>joycecmd</AssemblyName>
        <TargetName>joycecmd</TargetName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Build.Framework" />
      <PackageReference Include="Microsoft.Build.Utilities.Core" />
      <PackageReference Include="SkiaSharp" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
      <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
      <PackageReference Include="System.Text.Json" />
    </ItemGroup>

</Project>
