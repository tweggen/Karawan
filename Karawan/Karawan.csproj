<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <!-- TargetFramework>net9.0-windows10.0.22000.0</TargetFramework -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <!-- TargetFramework>net8.0-windows10.0.17763.0</TargetFramework -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <StartupObject>Karawan.DesktopMain</StartupObject>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- PlatformTarget>x64</PlatformTarget -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>True</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputType>Winexe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
    <PublishAot>False</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="cause\**" />
    <EmbeddedResource Remove="cause\**" />
    <None Remove="cause\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\README.md">
      <Link>README.md</Link>
    </Content>
    <Content Include="appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boom.OpenAL\Boom.OpenAL.csproj" />
    <ProjectReference Include="..\Boom\Boom.csproj" />
    <ProjectReference Include="..\Joyce\Joyce.csproj" />
    <ProjectReference Include="..\nogame\nogame.csproj" />
    <ProjectReference Include="..\Splash.OpenGL\Splash.OpenGL.csproj" />
    <ProjectReference Include="..\Splash\Splash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Silk.NET.Core removed by WP-5.4. It was the last Silk package any shipping
      project referenced, and nothing used it: the only `using Silk.NET.Core;` in
      this file was left behind when WP-4.4 removed Silk.NET.Maths, and the two
      remaining Silk-looking call sites are Splash.OpenGL - our own namespace.
    -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <!--
      Ultz.Native.Assimp removed by WP-4.4. This carried the native assimp for the
      DESKTOP build; with fbx import moved to build time there is nothing left in
      this process to load it. The pin comment it replaced ("5.1.4 due to
      animation artifacts in 2.22/5.4.1 on mac os") now lives where the importer
      does, in Mazu, which is the project that still needs the native.
    -->
  </ItemGroup>

</Project>
