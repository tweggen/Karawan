<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			SINGULAR TargetFramework. With the plural form - even carrying exactly one value -
			MSBuild builds an outer, framework-less pass that has no Run target and no
			deployment properties, which is why `dotnet build -t:Run` needed an explicit -f and
			why Rider reported 'Unable evaluate deployment properties' and refused to deploy.
			The plural form only earns its keep once a second TFM is actually built; the tizen
			and maccatalyst lines below have been commented out for as long as they have
			existed. Restore <TargetFrameworks> if one of them is ever uncommented.
		-->
		<TargetFramework>net9.0-android36.0</TargetFramework>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net7.0-maccatalyst</TargetFrameworks> -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net7.0-tizen</TargetFrameworks> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>Wuka</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!--
			WP-1.6 (deferred from WP-0.3). XA4301 = duplicate native library in the APK.
			Zero occurrences today, so promoting it is free, and it is exactly the
			regression that adding a natives package could reintroduce silently.

			XA0141 (shared library without a 16 KB page size) IS NOW HERE TOO, which closes
			AC-1.7. WP-1.6 could only promote XA4301: promoting XA0141 then produced 4
			errors, every one of them naming a library we do not build -

			  libSDL2.so, libmain.so  <-  Silk.NET.Windowing.Sdl 2.23.0's .aar, p_align 0x1000

			- so the criterion was not satisfiable by fixing our own natives, only by
			removing Silk's SDL2. WP-2.2 did exactly that, and every native left in the APK
			is 16 KB aligned, including the libmain.so we now build ourselves.

			Leave both promoted. Between them they are the two defects that made a Play
			Store upload impossible, and each is the kind that ships silently otherwise.
		-->
		<MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);XA4301;XA0141</MSBuildWarningsAsErrors>

		<!--
			SINGULAR RuntimeIdentifier, not the plural RuntimeIdentifiers. Rider cannot
			deploy a project that lists several: it reports 'Unable evaluate deployment
			properties' and refuses to start, because $(RuntimeIdentifier) evaluates to empty
			and it has nothing to pick. `dotnet build -t:Run` tolerates it; the IDE does not,
			and debugging on device is how this gets diagnosed.

			arm64 only is the honest target anyway: Google Play has required 64-bit for years,
			the 16 KB page-size rule applies only to 64-bit ABIs, and armeabi-v7a is 32-bit
			legacy. Our natives do build for it, so add it back as a second RID for a release
			AAB if it is ever wanted - but not while it costs on-device debugging.

			The default set (arm64-v8a + x86_64) is still wrong for us: we build no x86_64
			natives, so that split would ship without libSDL3.so or libmain.so. See WP-0.3 4.3 -
			it already lacked openal, assimp and libc++_shared, so it never worked.
		-->
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>

		<!-- Display name -->
		<ApplicationTitle>Wuka</ApplicationTitle>

		<!--
			App Identifier. MUST equal the package= attribute of
			Platforms/Android/AndroidManifest.xml, which is what actually ships: the
			.NET Android SDK honours an explicit package= in a hand-written manifest
			over $(ApplicationId), so the APK, the installed package and the launch
			intent are all de.nassau_records.silicondesert2 regardless of this line.

			It used to say com.companyname.wuka - the MAUI template default, never
			corrected. Nothing in the build noticed, because the manifest won every
			time. But any tool that asks MSBuild "what does this project deploy?"
			instead of parsing the manifest got the wrong package name, and a deploy
			that installs one package and then launches/uninstalls another fails in
			ways that only show up as a not-installed package on the device.
		-->
		<ApplicationId>de.nassau_records.silicondesert2</ApplicationId>
		<ApplicationIdGuid>cf727d7c-225f-415c-9ec3-21ba97580dbc</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>
	<PropertyGroup>
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
	</PropertyGroup>
	<PropertyGroup>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <EnableNETAnalyzers>False</EnableNETAnalyzers>
	  <Nullable>disable</Nullable>
	  <Title>Silicon Desert 2</Title>
	  <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
	  <RunAOTCompilation>False</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" / -->
		<!-- MauiIcon Include="Resources\mipmap\appicon.png" Color="#080800" / -->
		<MauiSplashScreen Include="Resources\Splash\splash_nassau.svg" Color="#000000" BaseSize="144, 144" />

		<Resource Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- MauiImage Include="Resources\Images\dotnet_bot.svg" / -->
		<MauiImage Include="Resources\mipmap\appicon.png" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Platforms\Android\android\arm64-v8a\libopenal.so" />
	  <None Remove="Platforms\Android\libopenal.so" />
	  <None Remove="Platforms\Android\libs\arm64-v8a\libopenal.so" />
	  <None Remove="Platforms\Android\libs\armeabi-v7a\libopenal.so" />
	  <None Remove="Platforms\Android\mapicons.png" />
	  <None Remove="Platforms\Android\mipmap\appicon_android.png" />
	  <None Remove="Platforms\Android\Prototype.ttf" />
	  <None Remove="Resources\Splash\splash_nassau.svg" />
		<AndroidNativeLibrary Include="Platforms\Android\android\arm64-v8a\libc++_shared.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AndroidNativeLibrary>
	  	<AndroidNativeLibrary Include="Platforms\Android\android\arm64-v8a\libassimp.so">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AndroidNativeLibrary>
		<AndroidNativeLibrary Include="Platforms\Android\android\armeabi-v7a\libc++_shared.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AndroidNativeLibrary>
		<AndroidNativeLibrary Include="Platforms\Android\android\armeabi-v7a\libassimp.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AndroidNativeLibrary>
	</ItemGroup>

	<ItemGroup>
		<!--
			SDL3's Android Java glue, vendored from the SAME SDL commit as the libSDL3.so
			we build (java/PROVENANCE.md). SDL3 registers its JNI methods dynamically from
			JNI_OnLoad rather than exporting Java_* symbols, so a mismatched pair fails at
			RUNTIME with NoSuchMethodError, not at build time - hence one pin for both.

			Bind="true" generates the C# binding GameActivity and GameSurface derive from.
			Metadata.xml trims four fields whose types are package-private Java helpers the
			binding generator cannot emit.

			Listed explicitly because MAUI sets EnableDefaultAndroidItems=false, so none of
			the SDK's default globs apply in this project.
		-->
		<AndroidJavaSource Include="Platforms\Android\java\**\*.java" Bind="true" />
		<TransformFile Include="Platforms\Android\Transforms\Metadata.xml" />
	</ItemGroup>

	<Import Project="../nogame/generated/AndroidResources.xml" />
	
	<!-- Game launch configuration -->
	<ItemGroup>
	  <AndroidAsset Include="../models/game.launch.android.json" LogicalName="game.launch.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidAsset>
	</ItemGroup>
	
	<ItemGroup>
	  <AndroidNativeLibrary Include="Platforms\Android\android\arm64-v8a\libopenal.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidNativeLibrary>
	  <!--
	    libmain.so: SDL's Java glue calls nativeRunMain("libmain.so", "SDL_main", ...) and
	    libSDL3.so does not export SDL_main - it is a library, not an application. Built by
	    recipes/build-mainshim.sh from WP-0.0's reconstruction of the shim Silk used to ship
	    inside its .aar, with a symbol table asserted to match Silk's.
	  -->
	  <AndroidNativeLibrary Include="Platforms\Android\android\arm64-v8a\libmain.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidNativeLibrary>
	  <AndroidNativeLibrary Include="Platforms\Android\android\armeabi-v7a\libmain.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidNativeLibrary>
	  <!--
	    libSDL3.so, from Karawan.Natives, but checked in beside the other natives rather
	    than consumed from the package.

	    The package reference above carries ExcludeAssets="all" (WP-1.5), because its .aar
	    also contains libopenal.so and libc++_shared.so - both already supplied here - and
	    two copies of one .so is the XA4301 promoted at the top of this file. Taking the
	    .aar wholesale therefore fails the build; taking one file out of it does not.

	    THIS WAS CAUGHT BY LISTING THE APK, NOT BY THE BUILD. Without these two entries
	    everything compiled, XA0141 and XA4301 both stayed clean, and the APK simply had no
	    libSDL3.so in it - the app would have died at SDL.loadLibrary("SDL3") on the device.

	    Phase 4 removes Assimp from the runtime, which dissolves the libc++ ABI constraint;
	    at that point all of these collapse into a single package reference.
	  -->
	  <AndroidNativeLibrary Include="Platforms\Android\android\arm64-v8a\libSDL3.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidNativeLibrary>
	  <AndroidNativeLibrary Include="Platforms\Android\android\armeabi-v7a\libSDL3.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AndroidNativeLibrary>
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Include="Platforms/Android/Resources/values/colors.xml">
		</AndroidResource>
	  <AndroidResource Include="Platforms\Android\mipmap-anydpi-v26\sd_launcher.xml">
	    <Generator>MSBuild:UpdateGeneratedFiles</Generator>
	  </AndroidResource>
	  <AndroidResource Include="Platforms\Android\mipmap-anydpi-v26\sd_launcher_round.xml">
	    <Generator>MSBuild:UpdateGeneratedFiles</Generator>
	  </AndroidResource>
	  <AndroidResource Include="Platforms\Android\mipmap\sd_launcher.png" />
	  <AndroidResource Include="Platforms\Android\mipmap\sd_launcher_round.png" />
	  <AndroidResource Include="Platforms\Android\mipmap-hdpi\appicon_foreground.png" />
	  <AndroidResource Include="Platforms\Android\mipmap-mdpi\appicon_foreground.png" />
	  <AndroidResource Include="Platforms\Android\mipmap-xhdpi\appicon_foreground.png" />
	  <AndroidResource Include="Platforms\Android\mipmap-xxhdpi\appicon_foreground.png" />
	  <AndroidResource Include="Platforms\Android\mipmap-xxxhdpi\appicon_foreground.png" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Explicit because Central Package Management (WP-0.1) turns MAUI's implicit
			references off: Microsoft.Maui.Sdk's BundledVersions.targets sets
			DisableMauiImplicitPackageReferences=true whenever
			ManagePackageVersionsCentrally is true. Without this line, UseMaui=true no
			longer pulls in Microsoft.Maui.Controls at all. Version lives in
			Directory.Packages.props.
		-->
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Silk.NET.Assimp" />
		<!--
			WP-1.5 replaced Silk.NET.OpenAL.Soft.Native with Karawan.Natives in
			Boom.OpenAL, from where it arrives here transitively. On DESKTOP that is the
			whole change and it is verified working.

			ANDROID deliberately keeps using the checked-in libraries under
			Platforms/Android/android/<abi>/, and the package's payload is excluded here,
			for two concrete reasons:

			  1. Duplicates. The package's .aar carries jni/<abi>/libopenal.so and
			     libc++_shared.so, both of which are already supplied as
			     AndroidNativeLibrary items below. Two copies of the same .so is exactly
			     the XA4301 that WP-0.3 inventoried.
			  2. C++ runtime ABI. libassimp.so was built against a different NDK than the
			     one that produced the package's libc++_shared.so, and only ONE
			     libc++_shared.so ships in an APK (recipes/BUILD_NOTES.md). Swapping it
			     underneath assimp risks a mismatch that no build check would catch -
			     it would surface as a crash on a device.

			It would also drag in libSDL3.so, ~2.2 MB per ABI, which nothing loads until
			Phase 2/3 moves windowing onto SDL3.

			Phase 4 removes Assimp from the runtime entirely, which dissolves reason 2.
			Revisit then, and drop the checked-in natives in favour of the package.
		-->
		<PackageReference Include="Karawan.Natives" ExcludeAssets="all" PrivateAssets="all" />
		<!--
			WP-2.2: Silk.NET.SDL, Silk.NET.Windowing, Silk.NET.Windowing.Sdl,
			Silk.NET.Input.Sdl and Ultz.Native.SDL are GONE. Android runs on SDL3 now,
			through Splash.Silk's Sdl3WindowBackend.

			THIS COULD NOT BE STAGED (KI-9). Silk.NET.Windowing.Sdl's .aar carries a
			classes.jar with org.libsdl.app.*, and the vendored SDL3 Java sources declare
			the same classes. With both present the build fails at dex time:

			  Type org.libsdl.app.HIDDeviceBLESteamController$1 is defined multiple times

			so SDL3's glue can only arrive in the very change that removes Silk's SDL2.

			Removing the direct references is NOT sufficient, which the dex error above says
			plainly. Splash.Silk references the Silk.NET.Windowing and Silk.NET.Input
			META-packages, and those pull Windowing.Sdl and Input.Sdl - and therefore the
			SDL2 .aar - in transitively. The two exclusions below cut that off for the
			Android build only.

			Safe because nothing on this platform uses them any more: the Silk types
			Splash.Silk compiles against (IView, IWindow) live in Windowing.Common, and
			Android no longer calls Window.GetView at all - Sdl3WindowBackend creates the
			window itself. Desktop is untouched; it still resolves the full meta-package.
		-->
		<PackageReference Include="Silk.NET.Windowing.Sdl" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Silk.NET.Input.Sdl" ExcludeAssets="all" PrivateAssets="all" />
		<!--
			Ultz.Native.SDL rides in behind Silk.NET.SDL and ships SDL2 for desktop RIDs.
			RID fallback then packages runtimes/linux-{x64,arm64}/native/libSDL2-2.0.so into
			the APK - glibc binaries that cannot load on Bionic, neither of them 16 KB
			aligned. Exactly KI-6's defect class, and the promoted XA0141 catches it:

			  error XA0141: ... 'libSDL2-2.0.so' ... 'runtimes/linux-x64/native/libSDL2-2.0.so'

			ExcludeAssets="all", not just "native": nothing on Android needs any part of
			Silk's SDL2 any more.
		-->
		<PackageReference Include="Ultz.Native.SDL" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Silk.NET.SDL" ExcludeAssets="all" PrivateAssets="all" />
		<!--
			Transitive dep of Joyce. ImGui.NET has no Android native, so RID fallback was
			packaging its runtimes/linux-x64/native/libcimgui.so into lib/x86_64/ of the APK
			(1.7 MB) - a glibc-linked binary that cannot load on bionic, and one of only five
			libraries in the APK that are not 16 KB page aligned (WP-0.3-WARNINGS.md).

			Excluding the native is safe today because ImGui is the in-game debugger and is
			switched off on Android: models/game.launch.android.json sets "createUI": "false",
			so Platform.cs never constructs the ImGui controller and nothing ever P/Invokes
			into cimgui.

			TO RE-ENABLE the in-game debugger on Android, this exclusion is not enough on its
			own - there is no Android build of cimgui in the ImGui.NET package at all. A real
			arm64-v8a libcimgui.so has to be built and shipped (the same problem Phase 1 solves
			for openal-soft and SDL), and only then does flipping "createUI" back to "true"
			do anything.

			NOTE: no PrivateAssets="all" here, unlike the two entries above. Those packages are
			native-only, but ImGui.NET also carries the managed ImGui.NET.dll that Joyce's UI
			code compiles against. Adding PrivateAssets="all" drops that assembly from the
			Android output entirely (verified: ImGui.NET.dll disappears from
			obj/.../android/assets/<abi>/), which would turn any accidental touch of a
			joyce.ui type into a runtime assembly-load failure the build cannot catch.
		-->
		<PackageReference Include="ImGui.NET" ExcludeAssets="native" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Boom.OpenAL\Boom.OpenAL.csproj" />
	  <ProjectReference Include="..\Joyce\Joyce.csproj" />
	  <ProjectReference Include="..\nogame\nogame.csproj" />
	  <ProjectReference Include="..\Splash.Silk\Splash.Silk.csproj" />
	  <ProjectReference Include="..\Splash\Splash.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="..\models\fonts\Slideyouran-Regular.ttf">
	    <Link>models\fonts\Slideyouran-Regular.ttf</Link>
	  </Content>

	  <Content Include="..\models\menu\shop.xml">
	    <Link>models\menu\shop.xml</Link>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="..\models\kanshu\">
	    <Link>models\kanshu</Link>
	  </Folder>
	</ItemGroup>


</Project>
