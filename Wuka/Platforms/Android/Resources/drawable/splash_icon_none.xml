<?xml version="1.0" encoding="utf-8"?>
<!--
  A deliberately invisible splash icon.

  From API 31 the system draws a splash whether or not you ask for one, and with no
  windowSplashScreenAnimatedIcon set it falls back to the LAUNCHER ICON - which is exactly
  the "large rendition of the app icon" this replaces. There is no attribute meaning "no
  icon", so the way to suppress it is to hand it something fully transparent.

  The visible splash is then windowBackground (@drawable/splash_window), which is unmasked
  and shows the title whole.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
  <solid android:color="@android:color/transparent" />
  <size android:width="1dp" android:height="1dp" />
</shape>
