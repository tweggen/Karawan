<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FBX import, as a BUILD-TIME-ONLY library (WP-4.4).

    This code used to live in JoyceCode and therefore in Joyce, which every
    runtime target references - so Silk.NET.Assimp and libassimp.so shipped with
    the game whether or not anything imported an fbx at runtime. Phase 4's whole
    point is that nothing does: Chushi bakes each model into a mo-{hash} file and
    the game loads that.

    So the importer moved here, and only the build tools reference it. Removing
    this reference from a runtime project is what removes Assimp from that
    binary; nothing else is needed, and nothing else keeps it out.

    Consumers: Chushi (via Mazu) and the test suite. NOT Karawan, NOT Wuka.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>builtin.loader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- We use Assimp 2.22 on all platforms because of a mac os issue with assimp 6.0.2/Silk.NET.Assimp.5.4.2 -->
    <PackageReference Include="Silk.NET.Assimp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Joyce\Joyce.csproj" />
  </ItemGroup>

</Project>
